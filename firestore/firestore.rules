rules_version = '2';

// FinalProject_DRRM — Firestore security rules.
// Roles: resident < dispatcher < rescueTeam < dmo, with `admin` as superuser.
// Web portal is staff-only (admin/dispatcher/rescueTeam/dmo); residents use mobile.
// Only `admin` may create/update/delete staff accounts.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // Disabled accounts (active: false) lose all role-based access.
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isSignedIn() && isActive() && role() == 'admin';
    }
    function isDispatcher() {
      return isSignedIn() && isActive() && role() == 'dispatcher';
    }
    function isDmo() {
      return isSignedIn() && isActive() && role() == 'dmo';
    }
    function isRescueTeam() {
      return isSignedIn() && isActive() && role() == 'rescueTeam';
    }
    // Admin is a superuser: full staff access on the same database.
    function isStaff() {
      return isAdmin() || isDispatcher() || isDmo();
    }
    function isResponder() {
      return isStaff() || isRescueTeam();
    }
    // Dispatch-level writes: dispatchers plus the superuser admin.
    function canDispatch() {
      return isDispatcher() || isAdmin();
    }
    // PII (§8): a rescue team member may access a report's victim/contact details
    // only once their team (users/{uid}.teamId) is assigned to that report.
    function isAssignedToReport(reportId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId
           == get(/databases/$(database)/documents/reports/$(reportId)).data.teamId;
    }
    // Residents may raise a fixed-shape "new report" ping to dispatchers/admins
    // about their own report — nothing else.
    function isDispatcherOrAdminUid(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role in ['dispatcher', 'admin'];
    }
    function validNewReportPing() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['type', 'reportId', 'userId', 'read', 'createdAt', 'title', 'body'])
        && request.resource.data.type == 'new_report'
        && request.resource.data.read == false
        && request.resource.data.reportId is string
        && request.resource.data.userId is string
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('body', '') is string
        && isDispatcherOrAdminUid(request.resource.data.userId)
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data.reporterId == request.auth.uid;
    }
    function validStatus(s) {
      return s in ['Submitted', 'Under Verification', 'Verified', 'Awaiting Assignment',
                   'Team Assigned', 'Rescue in Progress', 'Resolved', 'Closed',
                   'Rejected', 'Duplicate', 'Cancelled'];
    }
    function validPriority(p) {
      return p in ['low', 'medium', 'high'];
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Users: read own doc; staff read all. Self-registration always creates a resident.
    // Only an admin may create/update/delete staff accounts (role/active), and an
    // admin may not change their own role/active (prevents self-lockout).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create: if (request.auth.uid == uid
                        && request.resource.data.role == 'resident'
                        && request.resource.data.active == true)
                    || isAdmin();
      // Self-service profile edits (never role/active); admins manage anyone; and
      // dispatch staff may assign a rescue responder to a team by setting teamId
      // ONLY (nothing else changes) — this is what drives assigned-team PII access.
      allow update: if (request.auth.uid == uid
                        && !changedKeys().hasAny(['role', 'active']))
                    || (isAdmin() && request.auth.uid != uid)
                    || (canDispatch()
                        && request.auth.uid != uid
                        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'rescueTeam'
                        && request.resource.data.role == 'rescueTeam'
                        && changedKeys().hasOnly(['teamId', 'updatedAt']));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Reports: residents create/read their own; responders read all; staff update status/priority.
    match /reports/{id} {
      allow read: if isSignedIn()
                  && (resource.data.reporterId == request.auth.uid || isResponder());
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'Submitted'
                    && validPriority(request.resource.data.priority)
                    && request.resource.data.imageUrls.size() <= 3;
      allow update: if (isStaff()
                        && validStatus(request.resource.data.status)
                        && validPriority(request.resource.data.priority))
                    || (resource.data.reporterId == request.auth.uid
                        && !changedKeys().hasAny(['status', 'priority', 'verifiedBy']))
                    || (isResponder()
                        && validStatus(request.resource.data.status)
                        && !changedKeys().hasAny(['priority', 'verifiedBy', 'reporterId']));
      allow delete: if canDispatch();
    }

    // Per-report victim/contact details (PII): reporters own their own; staff read;
    // a rescue team reads only once its team is assigned to the report (§8).
    match /reportContacts/{reportId} {
      allow read: if isSignedIn()
                  && (isStaff()
                      || (isRescueTeam() && isAssignedToReport(reportId))
                      || get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid);
      allow create: if isSignedIn()
                    && (isStaff()
                        || get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid);
      allow update: if isStaff() || (isRescueTeam() && isAssignedToReport(reportId));
      allow delete: if canDispatch();
    }

    // Clusters / teams / assignments / rescueRecords: responders only.
    match /clusters/{id} {
      allow read: if isResponder();
      allow write: if canDispatch();
    }
    match /teams/{id} {
      allow read: if isResponder();
      allow write: if canDispatch();
    }
    match /assignments/{id} {
      allow read: if isResponder();
      allow create, delete: if canDispatch();
      allow update: if canDispatch() || isRescueTeam();
    }
    match /rescueRecords/{id} {
      allow read: if isResponder();
      allow create: if isRescueTeam() || canDispatch();
      allow update, delete: if canDispatch();
    }

    // Notifications: a user reads/updates their own; responders create; staff delete.
    // Residents may only create the fixed-shape "new_report" ping (see above).
    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isResponder() || validNewReportPing();
      allow delete: if isStaff();
    }

    // Shared config (e.g. config/dispatch = list of dispatcher uids).
    // Readable by any signed-in user so mobile can route pings; admin writes.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Audit log: append-only, uid cannot be spoofed; staff read.
    match /logs/{id} {
      allow read: if isStaff();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // PAGASA typhoon bulletins: read-only feed for signed-in users.
    // Writes happen only via the REST seeder (scripts/seed_demo.js) or the console.
    match /bulletins/{bulletinId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Forecast feeds (e.g. Open-Meteo rain): read-only.
    match /forecasts/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
